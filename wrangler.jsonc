{
  "name": "huevo-tests",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "huevo-tests", "database_id": "REPLACE_AFTER_d1_create", "migrations_dir": "migrations" }
  ],
  // "routes": [{ "pattern": "tests.example.com", "custom_domain": true }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "HUEVO_CLIENT_ID": "",
    "ADMIN_IDS": "",
    "COMMISSION_PCT": "10",
    "DEV_LOGIN": "0"
  }
}
